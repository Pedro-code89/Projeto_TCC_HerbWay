<div class="filtros">
  <label><span class="sr-only">Categoria</span><select id="filtroCategoria">
      <option value="">Todas as categorias</option>
      <option>Jardinagem</option>
      <option>Poda</option>
      <option>Paisagismo</option>
      <option>Manutenção de Jardim</option>
    </select></label>
  <label><span class="sr-only">Cidade</span><select id="filtroCidade">
      <option value="">Todas as cidades</option>
    </select></label>
  <label><span class="sr-only">Avaliação mínima</span><select id="filtroAvaliacao">
