<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../Components/head', { titulo: 'Reenviar verificação', estilos: ['login.css'], scripts: ['reenviar.js'] }) %>
<body>
  <%- include('../Components/cabecalho') %>
  <main class="acesso" id="conteudo">
    <section class="card form-wrapper">
      <span class="selo-acesso">VERIFICAÇÃO</span>
      <h1>Reenviar e-mail de verificação</h1>
      <form id="form-acesso" class="form-acesso">
        <label>E-mail<input name="email" id="email" type="email" autocomplete="email" required maxlength="120" placeholder="seuemail@exemplo.com"></label>
        <p class="erro-form" id="erro-acesso" role="alert" hidden></p>
        <button class="botao botao-verde" type="submit">Reenviar</button>
      </form>
      <p class="form-footer"><a href="/login">Voltar ao login</a></p>
    </section>
  </main>
  <%- include('../Components/rodape') %>
</body>
</html>
