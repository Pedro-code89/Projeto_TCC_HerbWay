<!DOCTYPE html><html lang="pt-BR">
<%- include('../Components/head', { titulo: 'Detalhes do serviço', estilos: ['style.css'], scripts: ['mapa.js', 'servico.js'], leaflet: true }) %>
<body data-servico="<%= id %>"><%- include('../Components/cabecalho') %>
<main class="container pagina-detalhe" id="conteudo">
  <a class="voltar" href="/servicos">← Voltar aos serviços</a>
  <div id="servico-inexistente" class="estado-vazio" hidden><h1>Serviço indisponível</h1><p>Este anúncio foi pausado ou removido.</p><a href="/servicos" class="link-verde">Encontrar outros serviços</a></div>
  <div class="detalhe-grid" id="detalhe-conteudo" hidden>
    <div class="detalhe-conteudo-principal">
      <article class="card detalhe-principal"><div class="detalhe-topo-acoes"><span class="categoria" id="servico-categoria"></span><button id="btn-visualizacoes-servico" class="botao-icone botao-visualizacoes" type="button" hidden aria-label="Ver visualizações do anúncio"><svg class="icone" aria-hidden="true"><use href="#icone-olho"></use></svg><span class="sr-only">Visualizações</span></button></div><h1 id="servico-titulo"></h1><p class="texto-cinza" id="servico-local"></p><div class="divisor"></div><h2>Sobre este serviço</h2><p class="descricao-completa" id="servico-descricao"></p><div class="detalhe-preco"><span>Valor do serviço</span><strong id="servico-preco"></strong></div></article>

      <section class="card fotos-servico" id="fotos-servico">
        <h2>Fotos</h2>
        <div class="lista-fotos" id="lista-fotos"></div>
        <div id="sem-fotos" class="sem-fotos bloco-vazio" hidden>
          <span>Sem fotos</span>
        </div>
      </section>

      <section class="card avaliacoes-servico" id="avaliacoes-servico" hidden>
        <h2>Avaliações</h2>
        <p class="texto-cinza" id="avaliacoes-vazio">Este serviço ainda não recebeu avaliações.</p>
        <ul class="lista-avaliacoes" id="lista-avaliacoes" tabindex="0" aria-label="Avaliações dos clientes"></ul>
      </section>

      <section class="card mapa-aproximado" id="secao-mapa-servico" aria-labelledby="titulo-mapa-servico">
        <h2 id="titulo-mapa-servico">Localização aproximada</h2>
        <p class="texto-cinza" id="mapa-servico-indisponivel" hidden>A localização aproximada não está disponível.</p>
        <div id="mapa-servico" class="mapa-canvas" hidden></div>
      </section>
    </div>

    <aside class="coluna-lateral card profissional-card"><span class="avatar" id="profissional-avatar" aria-hidden="true"></span><h2 id="profissional-nome"></h2><p class="texto-cinza" id="profissional-local"></p><p class="nota" id="profissional-avaliacao"></p><a class="botao botao-contorno" id="ver-profissional">Visualizar perfil</a>
      <div class="telefone-box campo-inteiro" id="telefone-box">
        <span class="telefone-rotulo">Telefone do profissional</span>
        <span class="telefone-numero" id="telefone-exibicao">(--)-****-****</span>
        <div class="telefone-acoes">
          <button class="botao botao-verde" id="desbloquear-telefone" type="button">Desbloquear telefone</button>
          <button class="botao botao-contorno" id="copiar-telefone" type="button" hidden>Copiar telefone</button>
        </div>
      </div>
      <button class="botao botao-verde" id="registrar-contratacao" type="button">Registrar contratação</button><a class="botao botao-verde" id="editar-anuncio" hidden>Editar meu anúncio</a><p class="ajuda" id="ajuda-contratacao">Já combinou o serviço com o profissional? Adicione ao seu histórico.</p>
    </aside>
  </div>
</main>
<dialog id="modal-foto" class="modal-foto" aria-label="Visualização da foto">
  <div class="modal-foto-corpo">
    <button class="botao-icone modal-foto-fechar" type="button" data-fechar aria-label="Fechar"><svg class="icone" aria-hidden="true"><use href="#icone-fechar"></use></svg></button>
    <button class="botao-icone modal-foto-nav modal-foto-anterior" id="foto-anterior" type="button" aria-label="Foto anterior">‹</button>
    <figure class="modal-foto-figura">
      <img id="foto-ampliada" alt="">
      <figcaption id="foto-legenda" class="texto-cinza"></figcaption>
    </figure>
    <button class="botao-icone modal-foto-nav modal-foto-proxima" id="foto-proxima" type="button" aria-label="Próxima foto">›</button>
    <p class="modal-foto-contador" id="foto-contador" aria-live="polite"></p>
  </div>
</dialog>
<dialog id="modal-visualizacoes-servico" aria-labelledby="titulo-vis-servico">
  <div class="modal-topo"><h2 id="titulo-vis-servico">Visualizações do anúncio</h2><button class="botao-icone" type="button" data-fechar aria-label="Fechar"><svg class="icone" aria-hidden="true"><use href="#icone-fechar"></use></svg></button></div>
  <div class="visualizacoes-painel">
    <div class="visualizacoes-periodos" role="group" aria-label="Período">
      <button type="button" class="botao botao-contorno ativa" data-periodo-vis="total" aria-pressed="true">Total</button>
      <button type="button" class="botao botao-contorno" data-periodo-vis="30d" aria-pressed="false">30 dias</button>
      <button type="button" class="botao botao-contorno" data-periodo-vis="7d" aria-pressed="false">7 dias</button>
    </div>
    <p class="visualizacoes-resumo"><strong data-vis-total>0</strong> visualizações · <strong data-vis-pessoas>0</strong> pessoas<span class="texto-cinza" data-vis-anonimos></span></p>
    <p class="texto-cinza" data-vis-status hidden></p>
    <ul class="visualizacoes-lista" data-vis-lista aria-label="Pessoas que visualizaram"></ul>
  </div>
</dialog>
<dialog id="modal-contratacao" aria-labelledby="titulo-contratacao"><div class="modal-topo"><h2 id="titulo-contratacao">Registrar contratação</h2><button class="botao-icone" type="button" data-fechar aria-label="Fechar"><svg class="icone" aria-hidden="true"><use href="#icone-fechar"></use></svg></button></div><p class="texto-cinza">Registre um serviço já combinado. Isso não envia uma solicitação ao profissional.</p>
  <form class="formulario" id="form-contratacao"><label class="campo-inteiro">Data do serviço<input type="date" name="data" required></label><p id="erro-contratacao" class="erro-form campo-inteiro" role="alert" hidden></p><div class="modal-acoes campo-inteiro"><button class="botao botao-contorno" type="button" data-fechar>Cancelar</button><button class="botao botao-verde" type="submit">Adicionar ao histórico</button></div></form>
</dialog><%- include('../Components/rodape') %></body></html>
