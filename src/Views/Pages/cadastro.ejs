<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../Components/head', { titulo: 'Criar conta' , estilos: ['cadastro.css'], scripts: ['cadastro.js'] }) %>

  <body>
    <%- include('../Components/cabecalho') %>
      <main class="acesso" id="conteudo">
        <section class="card form-wrapper">
          <span class="selo-acesso">CRIE SUA CONTA</span>
          <h1>Cadastre-se na HerbWay</h1>
          <p class="subtitle">Um perfil para encontrar profissionais e oferecer seus serviços.</p>
          <form id="form-acesso" class="form-acesso" method="post" action="/cadastro">
            <label>Nome completo<input name="nome" id="nome" autocomplete="name" required minlength="3" maxlength="100"
                placeholder="Seu nome completo"></label><label>E-mail<input name="email" id="email" type="email"
                autocomplete="email" required maxlength="120" placeholder="seuemail@exemplo.com"></label>
            <label>Senha<div class="campo-senha"><input name="senha" id="senha" type="password"
                  autocomplete="new-password" required minlength="6" maxlength="128"
                  placeholder="Crie uma senha de teste"><button type="button" class="mostrar-senha" data-senha="senha"
                  aria-label="Mostrar senha">Mostrar</button></div></label><label>Confirmar senha<input
                name="confirmar_senha" id="confirmar_senha" type="password" autocomplete="new-password" required
                minlength="6" maxlength="128" placeholder="Repita a senha de teste"></label>
            <p class="erro-form" id="erro-acesso" role="alert" hidden></p><button class="botao botao-verde"
              type="submit">Criar conta</button>
          </form>
          <p class="nota-demo">As informações são salvas no banco de dados HerbwayDB.
          </p>

          <p class="form-footer">Já possui uma conta? <a href="/login">Entrar</a></p>
        </section>
      </main>
      <%- include('../Components/rodape') %>
  </body>

</html>