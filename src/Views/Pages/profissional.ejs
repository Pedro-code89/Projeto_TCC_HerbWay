<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../Components/head', { titulo: 'Perfil do profissional' , estilos: ['style.css'], scripts:
  ['catalogo.js', 'mapa.js', 'profissional.js' ], leaflet: true }) %>

  <body data-profissional="<%= id %>"><%- include('../Components/cabecalho') %>
      <main class="container pagina-detalhe" id="conteudo"><a class="voltar" href="/servicos">← Voltar aos serviços</a>
        <p class="estado-vazio" id="perfil-inexistente" hidden>Perfil não encontrado.</p>
        <section class="card perfil-publico" id="perfil-publico" hidden>
          <div class="publico-identidade"><span class="avatar" id="publico-avatar" aria-hidden="true"></span>
            <div>
              <h1 id="publico-nome"></h1>
              <p id="publico-local" class="texto-cinza"></p>
              <p id="publico-avaliacao" class="nota"></p>
            </div>
            <button id="btn-visualizacoes-perfil-publico" class="botao-icone botao-visualizacoes" type="button" hidden aria-label="Ver visualizações do perfil" style="margin-left:auto"><svg class="icone" aria-hidden="true"><use href="#icone-olho"></use></svg></button>
          </div>
          <div class="divisor"></div>
          <h2>Sobre</h2>
          <p id="publico-sobre" class="descricao-completa"></p>
          <div class="divisor"></div>
          <div class="mapa-aproximado" aria-labelledby="titulo-mapa-publico">
            <h2 id="titulo-mapa-publico">Localização aproximada</h2>
            <p class="texto-cinza" id="mapa-publico-indisponivel" hidden>A localização aproximada não está disponível.</p>
            <div id="mapa-publico" class="mapa-canvas" hidden></div>
          </div>
        </section>
        <div id="servicos-profissional" hidden>
          <div class="header-resultados">
            <h2>Serviços oferecidos</h2><span id="totalResultados"></span>
          </div><%- include('../Components/listaServicos', { carrossel: false }) %>
        </div>
      </main>
      <dialog id="modal-visualizacoes-perfil-publico" aria-labelledby="titulo-vis-perfil-pub">
        <div class="modal-topo"><h2 id="titulo-vis-perfil-pub">Visualizações do perfil</h2><button class="botao-icone" type="button" data-fechar aria-label="Fechar"><svg class="icone" aria-hidden="true"><use href="#icone-fechar"></use></svg></button></div>
        <div class="visualizacoes-painel">
          <div class="visualizacoes-periodos" role="group" aria-label="Período">
            <button type="button" class="botao botao-contorno ativa" data-periodo-vis="total" aria-pressed="true">Total</button>
            <button type="button" class="botao botao-contorno" data-periodo-vis="30d" aria-pressed="false">30 dias</button>
            <button type="button" class="botao botao-contorno" data-periodo-vis="7d" aria-pressed="false">7 dias</button>
          </div>
          <p class="visualizacoes-resumo"><strong data-vis-total>0</strong> visualizações · <strong data-vis-pessoas>0</strong> pessoas<span class="texto-cinza" data-vis-anonimos></span></p>
          <p class="texto-cinza" data-vis-status hidden></p>
          <ul class="visualizacoes-lista" data-vis-lista aria-label="Pessoas que visualizaram"></ul>
        </div>
      </dialog>
      <%- include('../Components/rodape') %></body>

</html>